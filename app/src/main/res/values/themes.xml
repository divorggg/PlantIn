<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PlantIn" parent="android:Theme.Material.Light.NoActionBar" />
    <!-- Splash screen theme -->
    <style name="Theme.Plantin.Splash" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>


    </style>

    <style name="UCropTheme.NotFullscreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#66000000</item>
        <item name="android:navigationBarColor">#66000000</item>
    </style>


</resources>